        "@types/react-dom": "^18.3.7",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "bun-types": "^1.3.9",
        "clsx": "^2.1.1",
        "eslint": "^8.57.1",
        "formik": "^2.4.9",
        "idb": "^8.0.3",
        "imask": "^7.6.1",
        "lodash": "^4.17.23",
        "loglevel": "^1.9.2",
        "mermaid": "^10.9.5",
